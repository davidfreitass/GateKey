void logAndDisplay(String msg, bool clear = true, int line = 0) {
    Serial.println(msg);
    if (clear) lcd.clear();
    if (line > 1) line = 1;
    lcd.setCursor(0, line);
    if (msg.length() > 16) msg = msg.substring(0, 16);
    lcd.print(msg);
}

void serialOnlyPrint(String msg) {
    Serial.print(msg);
}

