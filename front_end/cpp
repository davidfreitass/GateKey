void streamCallback(FirebaseStream data) {
    logAndDisplay("--- DADO RECEBIDO ---");
    if (data.dataType() == "string") {
        String cmd = data.stringData();
        Serial.print("Conteúdo: ");
        logAndDisplay(cmd, false, 1);
        pendingCommand = cmd;
        if (pendingCommand == "enroll") {
            logAndDisplay(">> CADASTRO DETECTADO!", false, 0);
            logAndDisplay("LIGANDO LED...", false, 1);
        }
    }
    logAndDisplay("---------------------", false, 0);
}

void streamTimeoutCallback(bool timeout) {
    if (timeout) {
        logAndDisplay("AVISO: Stream Timeout.", true);
        logAndDisplay("Tentando reconectar...", false, 1);
    }
}

void sincronizarHoraNTP() {
    configTime(-3 * 3600, 0, "pool.ntp.org", "time.nist.gov");
    lcd.clear();
    lcd.print("Sincronizando hora");
    serialOnlyPrint("Sincronizando hora");
    int tentativas = 0;
    while (time(nullptr) < 1000000000 && tentativas < 20) {
        serialOnlyPrint(".");
        lcd.setCursor(16 + tentativas, 0);
        lcd.print(".");
        delay(500);
        tentativas++;
    }
    logAndDisplay(" OK!", false, 1);
}

String obterHoraAtual() {
    time_t agora = time(nullptr);
    struct tm timeinfo;
    localtime_r(&agora, &timeinfo);
    char buffer[30];
    strftime(buffer, sizeof(buffer), "%Y-%m-%d %H:%M:%S", &timeinfo);
    return String(buffer);
}

void portaAbrir(int id) {
    logAndDisplay("ACESSO PERMITIDO!", true);
    logAndDisplay("ID: " + String(id), false, 1);
    digitalWrite(ledV, HIGH);
    digitalWrite(ledR, LOW);
    meuServo.write(0);
    delay(3000);
    meuServo.write(90);
    digitalWrite(ledV, LOW);
    digitalWrite(ledR, HIGH);
    if (Firebase.ready()) {
        FirebaseJson log;
        log.set("fingerprintId", id);
        log.set("status", "ACESSO PERMITIDO");
        log.set("timestamp", obterHoraAtual());
        Firebase.RTDB.pushJSON(&fbdo, "/logs", &log);
    }
}

void portaNegada(String motivo) {
    logAndDisplay("ACESSO NEGADO!", true);
    logAndDisplay(motivo, false, 1);
    digitalWrite(ledV, LOW);
